# --- PostgreSQL (Docker Desktop) ---
# Host port exposed by the container. 5432 is often taken by another local Postgres.
POSTGRES_PORT=5433
POSTGRES_DB=homeplan3d
POSTGRES_USER=homeplan
# Change this value. Never commit a real password.
POSTGRES_PASSWORD=change-me

# --- Prisma / Next.js ---
# Must match the values above. Next.js runs on the host, PostgreSQL in Docker.
DATABASE_URL="postgresql://homeplan:change-me@localhost:5433/homeplan3d?schema=public"
