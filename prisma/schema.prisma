// HomePlan 3D — Prisma schema
//
// Modelling choices:
// - Every architectural entity (floor, room, wall, door, window, furniture,
//   material) is a relational row so projects stay queryable (counts, joins)
//   and referential integrity is enforced by PostgreSQL.
// - All geometry is stored in METERS as plain Float columns. Pixel conversion
//   belongs to the 2D editor, 3D conversion to the renderer.
// - Flexible, rarely-queried data (project settings, future room polygons)
//   lives in Json columns validated with Zod before any write.
// - IDs are UUIDs generated client-side so a plan keeps its ids across saves
//   (the editor's undo history and 3D scene stay consistent).
// - Every project belongs to a user. A project without owner is a public
//   showcase (the seeded demo): readable by everyone, writable by nobody.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  // Login identifier, stored trimmed and lower-cased.
  email        String   @unique
  name         String
  // scrypt hash with its salt and parameters (src/lib/auth/password.ts).
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  projects Project[]
}

model Session {
  // SHA-256 of the token held by the cookie: the table alone cannot open a session.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String?  @unique
  // Null for public showcases (the seeded demo).
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lotWidth    Float
  lotDepth    Float
  // Roof type, default wall height/thickness, material defaults (Zod validated).
  settings    Json
  // JPEG data URL captured from the real 3D view (dashboard thumbnail).
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floors    Floor[]
  materials Material[]

  @@index([ownerId])
  @@index([updatedAt])
}

model Material {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  // "wall" | "floor" | "roof" | "exterior"
  kind      String
  color     String
  roughness Float   @default(0.8)

  rooms Room[]
  walls Wall[]

  @@index([projectId])
}

model Floor {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  level     Int
  // Wall height for this floor (m).
  height    Float
  // Plan annotations (free texts and dimension lines), Zod validated.
  annotations Json @default("[]")

  rooms     Room[]
  walls     Wall[]
  furniture Furniture[]

  @@unique([projectId, level])
}

model Room {
  id              String    @id @default(uuid())
  floorId         String
  floor           Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name            String
  // "living" | "kitchen" | "bedroom" | "bathroom" | "toilet" | "hallway" | ...
  type            String
  // Rectangle in meters (top-left corner, plan coordinates).
  x               Float
  y               Float
  width           Float
  depth           Float
  // Reserved for non-rectangular rooms: array of {x, y} points.
  polygon         Json?
  floorMaterialId String?
  floorMaterial   Material? @relation(fields: [floorMaterialId], references: [id], onDelete: SetNull)
  sortOrder       Int       @default(0)

  @@index([floorId])
}

model Wall {
  id         String    @id @default(uuid())
  floorId    String
  floor      Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  // When a wall belongs to a room side it follows the room; null = free wall.
  roomId     String?
  side       String?
  x1         Float
  y1         Float
  x2         Float
  y2         Float
  thickness  Float
  height     Float
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  doors   Door[]
  windows Window[]

  @@index([floorId])
}

model Door {
  id     String @id @default(uuid())
  wallId String
  wall   Wall   @relation(fields: [wallId], references: [id], onDelete: Cascade)
  // Distance from the wall start to the door center (m).
  offset Float
  width  Float
  height Float
  // "standard" (leaf) | "opening" (no leaf)
  type   String @default("standard")
  // "left" | "right"
  swing  String @default("left")

  @@index([wallId])
}

model Window {
  id         String @id @default(uuid())
  wallId     String
  wall       Wall   @relation(fields: [wallId], references: [id], onDelete: Cascade)
  offset     Float
  width      Float
  height     Float
  sillHeight Float

  @@index([wallId])
}

model Furniture {
  id       String @id @default(uuid())
  floorId  String
  floor    Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  // "bed" | "sofa" | "table" | "wardrobe" | "kitchen" | "bathtub" | "toilet" | "desk"
  type     String
  x        Float
  y        Float
  // Degrees, counter-clockwise in plan coordinates.
  rotation Float  @default(0)
  width    Float
  depth    Float
  height   Float
  color    String

  @@index([floorId])
}
